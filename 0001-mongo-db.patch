+      { $sort: { ...(field === "reason" ? { count: -1 } : { _id: 1 }) } },
+      ...(limit ? [{ $limit: limit }] : []),
+    ])
+    .toArray();
+  return counts.map(({ _id, count }) => ({ [field]: _id, count }));
